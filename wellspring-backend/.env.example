# Configure these as environment variables in your shell or hosting provider.
# Do not commit real credentials or production secrets.
DB_URL=jdbc:mysql://localhost:3306/wellspring_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=wellspring_app
DB_PASSWORD=replace_with_a_local_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8080
